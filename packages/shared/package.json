{
  "name": "@expo-proxy/shared",
  "version": "0.1.0",
  "description": "Shared data contract for the Expo Proxy suite: system-agnostic POS transaction schema, Google identity verification, n8n cloud workflow client.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
